<env name="http_post">
		<http_request>
			<method>POST</method>
			<uri>http://127.0.0.1:9091/preview</uri>
			<headers>
				<field>
					<name>Content-Type</name>
					<value>application/vnd.vizrt.payload+xml</value>
				</field>
			</headers>
			<body>
				<![CDATA[<payload>
                <field name="setBoxes">
                    <value>]]>
				<ref><var>element</var>/data/SetBoxes/SetBoxes</ref>
				<![CDATA[</value>
                </field>
                <field name="elementId">
                    <value>]]>
				<var>element</var>
				<![CDATA[</value>
                </field>
            </payload>]]>
			</body>
			<on_response>
				<log>PREVIEW POST RESPONSE:</log>
				<log><var>body</var></log>
			</on_response>
			<on_failure>
				<log>PREVIEW POST FAILED:</log>
				<log><var>reason</var></log>
			</on_failure>
		</http_request>
	</env>
	<env profile="/config/profiles/PREVIEW" viz="LIVEBOXPREVIEW">
		<def var="elementID">
			<var>element</var>
		</def>
		<def var="boxType">
			<ref><var>element</var>/data/SetBoxes/SetBoxes</ref>
		</def>
		<log>ELEMENT = <var>elementID</var></log>
		<log>BOXTYPE = <var>boxType</var></log>
		<env command="take">
			<ref>/logic/element/run</ref></env>
		<forked_exec>
			<entry name="execution_group"><var>channel</var></entry>
			<viz>RENDERER*TREE*$SCRIPT*SCRIPT INVOKE msg_director_take <var>elementID</var>|<var>boxType</var></viz>
			<viz>RENDERER*TREE*$TAGSCRIPT*SCRIPT INVOKE ApplyTagData <ref><var>element</var>/data/tagsName/tagsName</ref></viz>
		</forked_exec>
	</env>